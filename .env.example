[TEMPLATE]
# These values are read in the browser and compiled into the bundle by Vite.
# Fetched data is cached for four hours, so each key is used sparingly.

# CoinGecko API Configuration
# Get your free API key at: https://www.coingecko.com/en/api

# Your CoinGecko API Key
VITE_COINGECKO_API_KEY=your_coingecko_api_key_here

# Optional: CoinMarketCap API key, used automatically when CoinGecko fails or
# runs out of credits. Without a key the app still falls back to CoinMarketCap's
# keyless public API, but price charts then need CoinGecko to be available.
# Get a key at: https://pro.coinmarketcap.com/signup
VITE_COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Optional: DefiLlama API key. The free API needs none. This is read by the
# scheduled snapshot job only (never shipped to the browser), so it does not use
# the VITE_ prefix. Get one at: https://defillama.com/pro-api
# DEFI_LLAMA_API_KEY=your_defillama_api_key_here

# --- Crypto News (scheduled job only, never shipped to the browser) ---
# Publisher RSS/Atom feeds are the primary source and need no key.
# Optional: CryptoPanic enrichment (sentiment / importance signals).
# Get a token at https://cryptopanic.com/developers/api
# CRYPTOPANIC_API_KEY=your_cryptopanic_auth_token
# CRYPTOPANIC_API_PLAN=growth
# Optional: CoinGecko key. The news adapter's /news endpoint requires the
# Analyst plan or above; without it the adapter is skipped and RSS alone drives
# the page. `npm run refresh:coins` also reads this key.
# Aliases accepted by the news job: COINGECKO_NEWS_API_KEY, COINGECKO_PRO_API_KEY.
# COINGECKO_API_KEY=your_coingecko_api_key

# Optional: API Base URLs (defaults shown below)
# VITE_API_BASE_URL=https://api.coingecko.com/api/v3
# VITE_CMC_API_BASE_URL=https://pro-api.coinmarketcap.com
# VITE_BINANCE_API_BASE_URL=https://api.binance.com
# VITE_OKX_API_BASE_URL=https://www.okx.com

# Optional: server-only base URL for `npm run refresh:coins` (default shown).
# COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3
